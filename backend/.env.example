# ==============================================================================
# Synapse Backend — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and adjust values for your local environment.
# Never commit the `.env` file to version control.
#
# When running via Docker Compose, DATABASE_URL and REDIS_URL are overridden
# by the docker-compose.yml environment section to use Docker service names.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=synapse-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────
# Local (without Docker Compose):
#   DATABASE_URL=postgresql+asyncpg://synapse:synapse_dev@localhost:5432/synapse
# Docker Compose overrides this via the environment section in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://synapse:synapse_dev@localhost:5432/synapse

# ── Redis ────────────────────────────────────────────────────────────────
# Local (without Docker Compose):
#   REDIS_URL=redis://localhost:6379/0
# Docker Compose overrides this via the environment section in docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
