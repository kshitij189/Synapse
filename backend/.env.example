# ==============================================================================
# Synapse Backend — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and adjust values for your local environment.
# Never commit the `.env` file to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=synapse-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database (not connected yet) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synapse

# ── Redis (not connected yet) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
